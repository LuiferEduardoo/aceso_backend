# Database (docker compose exposes Postgres on POSTGRES_PORT, default 5442)
DATABASE_URL=postgresql+asyncpg://aceso:aceso@localhost:5442/aceso
TEST_DATABASE_URL=postgresql+asyncpg://aceso:aceso@localhost:5442/aceso_test

# Auth
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fernet key used to encrypt third-party tokens at rest.
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# File uploads (exercise photos): STORAGE_BACKEND=local | s3
STORAGE_BACKEND=s3
# Used when STORAGE_BACKEND=local
UPLOAD_DIR=uploads
# Used when STORAGE_BACKEND=s3 (Cloudflare R2: R2 > Manage API tokens)
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto

# Strava OAuth app (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/running/strava/callback

# Google Calendar OAuth client (Google Cloud console > APIs & Services > Credentials,
# "Web application"; add GOOGLE_REDIRECT_URI as an authorized redirect URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/planner/google/callback
